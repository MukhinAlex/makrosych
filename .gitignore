# Данные пользователя: сценарии, задания, образцы, результаты и settings.json
# с личным ключом API. В репозиторий попадать не должны.
data/

# Портативный PHP и зависимости не хранятся в репозитории:
# они попадают в релизный архив, но не в историю git (иначе репозиторий ~90 МБ бинарников).
runtime/php/
vendor/

# Сборка лаунчера: собирается из launcher\Makrosych.cs командой launcher\build.bat.
# Исходник и значок в репозитории есть, готовый файл — только в релизном архиве.
Макросыч.exe

# Внутренние документы: план, принятые решения, рабочие заметки. Читателю репозитория
# нужен только короткий README.md.
PLAN.md
documentation_makros.md

# Служебные и временные файлы
*.log
*.tmp
Thumbs.db
Desktop.ini
